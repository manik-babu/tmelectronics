model User {
    id       String  @id @default(uuid())
    name     String?
    email    String? @unique
    phone    String? @unique
    password String?
    role     String  @default("USER")
    image    String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    carts     Cart[]
    orders    Order[]

    @@map("users")
}

enum UserRole {
    USER
    ADMIN
}
