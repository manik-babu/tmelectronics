model Brand {
    name String @id

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    products  Product[]

    @@map("brands")
}

model Offer {
    name           String    @id
    expirationDate DateTime
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt
    products       Product[]

    @@map("offers")
}

model Category {
    name String @id

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    products  Product[]

    @@map("categories")
}

model Color {
    id         String      @id @default(cuid())
    name       String
    stock      Int         @default(0)
    productId  String
    product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
    carts      Cart[]
    orderItems OrderItem[]

    @@unique([name, productId], name: "unique_color_per_product")
    @@index([productId], name: "idx_product_id")
    @@map("colors")
}

model Product {
    id               String    @id @default(cuid())
    sku              String    @unique
    rating           Decimal?  @db.Decimal(1, 1)
    title            String
    description      String?
    price            Decimal   @db.Decimal(10, 2)
    discounted_price Decimal?  @db.Decimal(10, 2)
    offer_name       String?
    offer            Offer?    @relation(fields: [offer_name], references: [name])
    brand_name       String?
    brand            Brand?    @relation(fields: [brand_name], references: [name])
    category_name    String?
    category         Category? @relation(fields: [category_name], references: [name])

    createdAt  DateTime    @default(now())
    updatedAt  DateTime    @updatedAt
    carts      Cart[]
    colors     Color[]
    orderItems OrderItem[]
    reviews    Review[]

    @@index([brand_name], name: "idx_brand_name")
    @@index([category_name], name: "idx_category_name")
    @@map("products")
}
