
// User model
model User {
  id       String   @id @default(uuid())
  name     String?
  phone    String?  @unique
  email    String?  @unique
  password String?
  role     UserRole @default(USER)
  image    String?

  createdAt DateTime @default(now())

  @@map("users")
}

enum UserRole {
  ADMIN
  USER
  GUEST
}

model Product {
  id          String   @id @default(uuid())
  title        String
  description String
  price       Float
  discountedPrice   Float?
  offerName   String?
  sku         String  @unique
  brand       String?
  category    String
  rating     Float?

  createdAt   DateTime @default(now())

  @@map("products")
}
