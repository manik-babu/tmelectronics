model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?  @unique
  password  String
  role      UserRole   @default(USER)
  image    String?

  createdAt DateTime @default(now())
  //   updatedAt DateTime temporal.updatedAt()
}
enum UserRole {
  ADMIN
  USER
}